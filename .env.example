# Copy to .env (git-ignored) and adjust. Real environment variables take precedence.
# Keep each variable once: if one appears twice, the last line wins.

WEBB_SIZE=1920x1080
WEBB_LANG=en                 # en | es
WEBB_TRANSLATE=none          # none | claude | ollama | argos
# ANTHROPIC_API_KEY=sk-ant-...
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b
# LLM_MAX_CALLS=20           # model requests per run (default 20 with ollama)
# OLLAMA_BUSY_UNITS=         # systemd units during which Ollama is left alone
# APOD_API_KEY=...           # free at https://api.nasa.gov

# WEBB_SOURCES=webb,hubble,apod
# POOL_APOD_WEIGHT=8
# POOL_APOD_RECENT=6
# POOL_RANDOM=40

# Which pool the TV shows: space | art | animals | space,art,animals (taking turns)
# | alternate | space:8-19,art:20-7. Anything but a single pool needs the
# --pool-only cron at every turn (see the README).
# SCHEDULE=space
# SCHEDULE_MINUTES=60        # minutes per turn, e.g. 20
# TV_SLOTS=48
# POOL_ART_WEIGHT=6
# POOL_ART_RANDOM=30
# ART_FETCH_WIDTH=1920
# ANIMALS_PER_DAY=12
# ANIMALS_MAX=240
# POOL_ANIMAL_WEIGHT=6
# POOL_ANIMAL_RANDOM=30
