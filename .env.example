# Copy to .env (git-ignored) and adjust. Real environment variables take precedence.
# Keep each variable once: if one appears twice, the last line wins.

WEBB_SIZE=1920x1080
WEBB_LANG=en                 # en | es
WEBB_TRANSLATE=none          # none | claude | argos
# ANTHROPIC_API_KEY=sk-ant-...
# APOD_API_KEY=...           # free at https://api.nasa.gov

# WEBB_SOURCES=webb,hubble,apod
# POOL_APOD_WEIGHT=8
# POOL_APOD_RECENT=6
# POOL_RANDOM=40

# Which pool the TV shows: space | art | alternate | space:8-19,art:20-7
# (anything but "space" needs the hourly --pool-only cron, see the README)
# SCHEDULE=space
# POOL_ART_WEIGHT=6
# POOL_ART_RANDOM=30
# ART_FETCH_WIDTH=1920
